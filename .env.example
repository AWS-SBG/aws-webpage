# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO=aws-builders@umich.edu

# Verified Resend sender. Defaults to noreply@umichbuilders.com, which requires
# umichbuilders.com to be verified in Resend. This mailbox never receives mail;
# replies go to the person who submitted the form via Reply-To.
CONTACT_FROM=noreply@umichbuilders.com
